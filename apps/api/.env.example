NODE_ENV=development
PORT=8787

# MongoDB Atlas connection string. Create a DB user with readWrite on the biizcon DB only,
# and restrict Atlas Network Access to your server's IPs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/biizcon?retryWrites=true&w=majority

# Comma-separated browser origins allowed to call the API (exact match, no trailing slash).
CORS_ORIGINS=http://localhost:5173

# Number of reverse proxies in front of the API (0 = direct, 1 = e.g. Render/Railway/Fly).
# Used to read the real client IP from X-Forwarded-For for rate limiting. Never set higher than reality.
TRUST_PROXY_HOPS=0

# --- Admin page + email (all required to enable /api/admin and /api/unsubscribe) ---
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
UNSUBSCRIBE_SECRET=
# Public URL of this API, used in unsubscribe links.
PUBLIC_API_URL=http://localhost:8787
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Biizcon <hello@yourdomain.com>
# Pause between emails (ms) to stay under your SMTP provider's rate limits.
MAIL_DELAY_MS=250
