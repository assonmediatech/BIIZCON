{
  "name": "biizcon",
  "private": true,
  "version": "1.0.0",
  "workspaces": ["apps/*"],
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:api",
    "dev:web": "npm run dev -w @biizcon/web",
    "dev:api": "npm run dev -w @biizcon/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": { "npm-run-all2": "^7.0.0" }
}
